---
// Client object photo. To add/replace a photo: drop `<slug>.jpg` into site/public/img/objects/
// (slugs: budynok-lviv, kvartyra-novobudova, avtosalon, hotel-truskavets, teplovyi-nasos-buisk, ochysni-konopnytsia).
// `npm run build`/`dev` runs scripts/optimize-images.mjs: WebP 480/800/1200 + src/data/images.json. Without a file a placeholder is shown.
import images from "../data/images.json";

interface Props {
  slug: string;
  alt: string;          // type + place
  tile?: string;        // name of the object type for the placeholder
  variant?: "tile" | "hero";
  eager?: boolean;      // LCP image: fetchpriority high, no lazy
  sizes?: string;
}
const { slug, alt, tile, variant = "tile", eager = false, sizes = "(min-width: 1100px) 50vw, 100vw" } = Astro.props;
const info = (images as Record<string, { file: string; width: number; height: number; widths: number[] }>)[slug];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (f: string) => `${base}/img/objects/${f}`;
const srcset = info ? info.widths.map((w) => `${url(`opt/${slug}-${w}.webp`)} ${w}w`).join(", ") : "";
---
{info ? (
  <picture>
    <source type="image/webp" srcset={srcset} sizes={sizes} />
    <img class="photo" src={url(info.file)} alt={alt} width={info.width} height={info.height}
      loading={eager ? "eager" : "lazy"} decoding="async" fetchpriority={eager ? "high" : undefined} />
  </picture>
) : (
  <div class:list={["photo", "photo--ph", `photo--${variant}`]} role="img" aria-label={`${alt}: фото об'єкта клієнта буде додано`}>
    {variant === "tile" && (
      <>
        <svg class="photo__mark" viewBox="0 0 44 32" width="44" height="32" aria-hidden="true"><path fill="#B3202E" d="M12 2h17L21 30H4z" /><path fill="#2D5BB5" d="M32 2h10l-8 28H24z" /></svg>
        <span class="photo__name">{tile ?? alt}</span>
      </>
    )}
    <span class="photo__cap">фото об'єкта клієнта</span>
  </div>
)}
<style>
  .photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .photo--ph { display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start; gap: var(--s-3); padding: var(--s-5); background: var(--color-bg-2); color: var(--color-text); }
  .photo--hero { background: var(--color-hot); color: var(--color-on-hot); justify-content: flex-end; }
  .photo__mark { width: 44px; height: auto; margin-bottom: auto; opacity: .9; }
  .photo__name { font: 700 var(--fs-2) / 1.15 var(--font-display); letter-spacing: -.01em; max-width: 14ch; }
  .photo__cap { font-size: .875rem; color: var(--color-muted); }
  .photo--hero .photo__cap { color: var(--color-on-hot); }
</style>
